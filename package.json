{
  "name": "tuxos",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "modules/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "check": "npm run typecheck && npm test",
    "dev": "node scripts/dev.mjs",
    "build": "npm run typecheck && npm run build --workspace @tuxos/web",
    "api": "npm run start --workspace @tuxos/api"
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "es-module-lexer": "2.3.2",
    "esbuild": "0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
