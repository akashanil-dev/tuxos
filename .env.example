# Local development only. Copy this file to .env and keep .env untracked. Never put a key in browser code or
# VITE_* vars. For production, inject secrets through the deployment platform's secret manager.

# AI. There is no server API key: learners choose a provider (Groq, NVIDIA, OpenRouter, Gemini, OpenAI...),
# add their own key and pick a model in Settings → AI. OPENAI_API_KEY is ignored if set.
# AI_FEATURES=1 offers AI at all. Off (the default), no AI request is ever made and the switch is greyed out.
# AI_FEATURES=1
# Let learners enter their own OpenAI-compatible address (public https only). Keep it off in production.
# ALLOW_CUSTOM_AI_URL=1
# Development only: also allow http and private addresses, e.g. Ollama at http://localhost:11434/v1. This lets
# the server reach its own network, so never set it on a public server.
# ALLOW_PRIVATE_AI_URL=1

# Optional. The API server's port (the web dev server forwards /api here) and a per-client request limit.
PORT=8787
TUTOR_REQUESTS_PER_MINUTE=30

# Optional. A Unix socket to listen on instead of PORT (production: /run/tuxos/api.sock, behind Caddy), the TCP
# address to listen on, and whether to trust the
# reverse proxy's client-IP header (Cloudflare's CF-Connecting-IP) for rate limiting. Only set TRUST_PROXY=1
# when the API is reachable solely through that proxy.
# SOCKET=/run/tuxos/api.sock
# HOST=127.0.0.1
# TRUST_PROXY=1

# Accounts and saved progress (SQLite; production: /var/lib/tuxos/tuxos.db). Sign-in attempts allowed per minute per
# visitor. COOKIE_SECURE=0 only for plain-http hosts other than localhost.
# DATABASE_PATH=data/tuxos.db
# AUTH_ATTEMPTS_PER_MINUTE=10
# COOKIE_SECURE=1
